#include <stdio.h>

int main() {
    int size, elements;

    printf("Enter the size: ");
    scanf("%d", &size);

    int arr[size];

    printf("Enter the number of elements: ");
    scanf("%d", &elements);

    printf("Enter the elements: ");
    for(int i = 0; i < elements; i++) {
        scanf("%d", &arr[i]);
    }

    int key;
    printf("Enter the element you want to search: ");
    scanf("%d", &key);

    int k = 0;
    int loc = -1;

    while(k < elements) {
        if(arr[k] == key) {
            loc = k;
            break;
        }
        k++;
    }

    if(loc == -1) {
        printf("Element not found");
    }
    else {
        printf("Element found at %d index", loc);
    }

    return 0;
}
